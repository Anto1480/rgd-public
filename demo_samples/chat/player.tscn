[node name="Rows" type="VBoxContainer" parent="UI/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Topic" type="Label" parent="UI/Margin/Rows"]
unique_name_in_owner = true
layout_mode = 2
